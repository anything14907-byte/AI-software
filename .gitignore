# ==============================================================================
# Git Ignore Configuration for AI Chat Assistant
# ==============================================================================

# Virtual environments
venv/
backend/venv/
ENV/
env/
.venv/

# Node dependencies
node_modules/
frontend/node_modules/
package-lock.json.bak

# Production builds
frontend/dist/
dist/

# Environment variables & local secrets (never commit API keys)
.env
backend/.env
*.env
!backend/.env.example

# Python bytecode & cache
__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# SQLite databases & runtime data
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
*.db
*.sqlite3

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
