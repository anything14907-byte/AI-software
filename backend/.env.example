# =================================================================
# Google Gemini AI Chat Assistant Configuration
# =================================================================

# Your Google Gemini API Key (get a free key at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model to use (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Backend server host and port
HOST=127.0.0.1
PORT=8000

# Assistant default configuration
DEFAULT_ASSISTANT_NAME=Gemini
DEFAULT_SYSTEM_PROMPT=You are Gemini, a helpful, thoughtful, and knowledgeable AI assistant. You give clear, accurate, and insightful responses. When writing code, provide clean, idiomatic code with clear explanations. Format responses using Markdown.

